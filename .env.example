# SQLite file is created automatically for local dev.
DATABASE_URL=file:data/bingewatcher.db

# On Netlify, use Turso instead (both required):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Movie metadata
TMDB_API_KEY=
OMDB_API_KEY=

# Auth — SESSION_SECRET must be at least 32 characters
INVITE_CODE=changeme
SESSION_SECRET=replace-with-a-long-random-secret-32+
