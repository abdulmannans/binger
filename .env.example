# SQLite file is created automatically. Leave DATABASE_URL blank for local.
# For hosted deploys (Vercel), use a free Turso database instead:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
DATABASE_URL=file:data/bingewatcher.db

# Movie metadata
TMDB_API_KEY=
OMDB_API_KEY=

# Auth — SESSION_SECRET must be at least 32 characters
INVITE_CODE=changeme
SESSION_SECRET=replace-with-a-long-random-secret-32+
